# Generate .env with `make env`. It refuses to overwrite an existing file.
# The password must be 16-128 characters from [A-Za-z0-9_-] so it can sit
# unescaped inside PG_CONN_STR. `make bootstrap` rejects the placeholder.
#
# `make` rebuilds PG_CONN_STR for the selected ENV. The database name becomes
# terraform_state_dev, terraform_state_staging or terraform_state_prod.
# STATE_DB_PORT below and the port in the sample URL are the same value.
# Keep them equal to state_db_port (default 55432).
#
# sslmode=disable is acceptable only because bootstrap publishes Postgres on
# 127.0.0.1. For a Postgres server on another host use sslmode=require
# (or verify-full) and point STATE_DB_HOST away from 127.0.0.1.
TF_VAR_state_db_password=change-me-please-16
STATE_DB_USER=terraform
STATE_DB_HOST=127.0.0.1
STATE_DB_PORT=55432
STATE_DB_SSLMODE=disable
PG_CONN_STR=postgres://terraform:change-me-please-16@127.0.0.1:55432/terraform_state_dev?sslmode=disable
