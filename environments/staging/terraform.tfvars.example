# Copy to terraform.tfvars (gitignored) only when you need to override a default.
# `make demo` works with the defaults below plus .env and `make ssh-key`.
# State database credentials are NOT set here. They live in .env.

project     = "lab"
owner       = "local"
environment = "staging"

# docker_host = "unix:///var/run/docker.sock"

frontend_cidr = "10.20.0.0/24"
backend_cidr  = "10.20.1.0/24"

node_count        = 2
node_memory_mb    = 768
node_cpu_shares   = 512
ssh_port_base     = 2301
ssh_user          = "ansible"
restart_policy    = "on-failure"
enable_lb         = true
lb_port           = 8080
db_memory_mb      = 512
backup_retention_days = 7

node_base_image = "ubuntu:24.04@sha256:73b999393d07f2bf65a40373778a44dc9a6d54ad7718d29247d8ff9413c4d6a8"
postgres_image  = "postgres:17.12@sha256:b60e90042aa6b8dbecd58e224b3e36114dbf8ad754465264c2476ad58a86e45c"
nginx_image     = "nginx:1.30.7@sha256:7fad6c0dff97965adbddf28027d934b111fc0221a554315dc274712f3fba24d3"

# systemd_privileged = false
# extra_capabilities = []
# security_opts      = []
