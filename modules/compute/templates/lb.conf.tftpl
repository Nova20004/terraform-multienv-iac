upstream lab_nodes {
%{ for upstream in upstreams ~}
  server ${upstream}:80;
%{ endfor ~}
}

server {
  listen 80;
  server_name _;

  location / {
    proxy_pass http://lab_nodes;
    proxy_set_header Host $${host};
    proxy_set_header X-Forwarded-For $${proxy_add_x_forwarded_for};
    proxy_set_header X-Forwarded-Proto $${scheme};
  }
}
