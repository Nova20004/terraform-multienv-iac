# Generated by Terraform for ${environment}. Do not edit.
# Re-apply the environment to refresh this file.
#
# Kernel tasks (sysctl, ufw, chrony) are skipped when both of these are true:
#   common_skip_kernel_tasks_when_docker=true
#   ansible_virtualization_type == docker
# Set the skip variable to false on a real VM.

[nodes]
%{ for node in nodes ~}
${node.name} ansible_host=127.0.0.1 ansible_port=${node.port} ansible_user=${ssh_user}
%{ endfor ~}

[nodes:vars]
ansible_ssh_private_key_file=${ssh_private_key_path}
ansible_python_interpreter=/usr/bin/python3
lab_environment=${environment}
lab_project=${project}
db_host=${db_host}
db_port=${db_port}
db_user=${db_user}
db_name=${db_name}
common_skip_kernel_tasks_when_docker=true
common_manage_sysctl=true
common_manage_ufw=true
common_manage_chrony=true
