# {{ ansible_managed }}
[Unit]
Description=Lab application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory=/opt/app
ExecStart=/usr/bin/python3 /opt/app/app.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
